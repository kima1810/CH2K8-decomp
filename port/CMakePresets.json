{
    "version": 6,
    "cmakeMinimumRequired": { "major": 3, "minor": 25, "patch": 0 },
    "configurePresets": [
        {
            "name": "win-amd64",
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/out/build/${presetName}",
            "cacheVariables": {
                "CMAKE_C_COMPILER": "clang",
                "CMAKE_CXX_COMPILER": "clang++",
                "CMAKE_BUILD_TYPE": "Release",
                "CMAKE_PREFIX_PATH": "${sourceDir}/sdk"
            },
            "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Windows" }
        },
        {
            "name": "win-amd64-vulkan",
            "displayName": "Windows AMD64 with Vulkan and D3D12",
            "inherits": "win-amd64",
            "cacheVariables": {
                "CMAKE_PREFIX_PATH": "${sourceDir}/sdk-vulkan",
                "CH2K8_REQUIRE_VULKAN": "ON"
            }
        }
    ],
    "buildPresets": [
        { "name": "win-amd64", "configurePreset": "win-amd64" },
        { "name": "win-amd64-vulkan", "configurePreset": "win-amd64-vulkan" }
    ]
}
